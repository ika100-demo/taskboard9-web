{
  "name": "taskboard9-web",
  "version": "0.1.1-dev.0",
  "private": true,
  "description": "Web UI for the taskboard9 system",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@vercel/otel": "^2.2.0",
    "next": "^16.4.4",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
